# ==============================================================================
# SO-101 Robot Arm Project - .gitignore
# ==============================================================================

# 1. Large Datasets (HDF5, Zarr, etc.)
data/*
!data/.gitkeep
*.hdf5
*.h5
*.zarr

# 2. Model Checkpoints & Pretrained Weights
ckpt/*
!ckpt/.gitkeep
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.pkl

# 3. Execution Logs, Diagnostic Data & Output Media
logs/*
!logs/.gitkeep
*.log
*.npz
*.npy
*.mp4
*.avi

# 4. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 5. Virtual Environments
venv/
.venv/
env/
ENV/

# 6. IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~
.directory

# 7. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 8. Jupyter Notebooks & Tests
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/

# 9. Temporary & Scratch Files
scratch/
*.tmp
*.bak*

# 10. Upstream External Repositories (exclude cloned repos with their own .git)
upstream_models/*
!upstream_models/act/

# 11. Analysis Visualizations & Outputs
analysis/outputs/
analysis/outputs_*/

